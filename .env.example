# Which LLMs to try, in order. "mock" needs no key and is always the last resort.
LLM_ORDER=groq,gemini,mock

# Free key: https://console.groq.com/keys  (LLM + Whisper speech-to-text)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BACKUP_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Free expressive voice on Groq (Orpheus). Accept its terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_TTS=on
GROQ_VOICE_FEMALE=autumn
GROQ_VOICE_MALE=daniel

# Optional backup LLM. Free key: https://aistudio.google.com/apikey
# Note: Gemini's free tier may use prompts to improve Google's products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional warm voice. Free tier: https://elevenlabs.io  (falls back to the browser voice)
ELEVENLABS_API_KEY=
# Voice IDs from your ElevenLabs Voice Library. Defaults: Sarah (female), George (male).
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
# eleven_multilingual_v2 sounds the most natural and emotional.
# eleven_flash_v2_5 is faster and uses half the credits, but sounds flatter.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Admin console (/admin) ---
# Signs staff sessions. Optional locally (a random one is saved to data/secret.key); set it on a server.
SECRET_KEY=
# Where the SQLite database lives (staff, settings, audit log, usage metadata). Use a persistent disk in production.
DATA_DIR=
# Create the first super admin on a server with no terminal. Used once, only if there are no staff yet; remove afterwards.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
